{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emeli",
  "version": "0.1.0",
  "identifier": "dev.emeli.mail",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4321",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Emeli",
        "width": 1100,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-src 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["net.thunderbird"]
      },
      "mobile": [
        {
          "scheme": ["net.thunderbird"],
          "host": "oauth"
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
