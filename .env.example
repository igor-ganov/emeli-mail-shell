# Emeli-mail shell — local secrets (copy to `.env`, which is git-ignored).
# NEVER commit real values. Share the CLIENT SECRET / APP PASSWORD by putting
# them in `.env` on disk — do not paste them into chat.

# ── Your Yahoo account ───────────────────────────────────────────────
EMELI_ACCOUNT_EMAIL=you@yahoo.com

# ── Path A: OAuth 2.0 (needs a Yahoo app + approved mail scope) ───────
# From developer.yahoo.com → your app. Client ID is not secret; the secret is.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# 'oob' shows the auth code on a Yahoo page for you to paste back (best for a
# desktop app with no public https callback). Or an https URL you registered.
YAHOO_REDIRECT_URI=oob
# Space-separated. Read + write mail. (Requires Yahoo's mail-scope approval.)
YAHOO_SCOPES=mail-r mail-w openid

# ── Path B: App Password (fastest — no OAuth approval needed) ─────────
# Generate at Yahoo Account Security → "Generate app password". Use it as the
# IMAP/SMTP password directly. Leave blank if using Path A.
YAHOO_APP_PASSWORD=

# ── Servers (defaults; rarely need changing) ─────────────────────────
YAHOO_IMAP_HOST=imap.mail.yahoo.com
YAHOO_IMAP_PORT=993
YAHOO_SMTP_HOST=smtp.mail.yahoo.com
YAHOO_SMTP_PORT=465
