# Emeli-mail shell — local config (copy to `.env`, which is git-ignored).
# This is a PUBLIC (native) client: it uses Authorization Code + PKCE and holds
# NO client secret. Nothing here is a secret you must hide — the client_id and
# app id are public by design; the security comes from the PKCE code_verifier,
# generated fresh per sign-in and never stored.

# ── Your Yahoo account ───────────────────────────────────────────────
EMELI_ACCOUNT_EMAIL=you@yahoo.com

# ── Yahoo public client (PKCE, no secret) ────────────────────────────
# Consumer Key = OAuth client_id (the long dj0y… value).
YAHOO_CLIENT_ID=
# Short Yahoo App ID (optional; informational).
YAHOO_APP_ID=
# 'oob' shows the auth code on a Yahoo page to paste back (best for desktop);
# or a custom-scheme deep link you registered (e.g. emeli://auth/callback).
YAHOO_REDIRECT_URI=oob
YAHOO_SCOPES=mail-r mail-w openid

# ── Servers (defaults) ───────────────────────────────────────────────
YAHOO_IMAP_HOST=imap.mail.yahoo.com
YAHOO_IMAP_PORT=993
YAHOO_SMTP_HOST=smtp.mail.yahoo.com
YAHOO_SMTP_PORT=465

# If — and only if — your Yahoo app is a CONFIDENTIAL client (Yahoo issued a
# Client Secret), the secret must NOT live here. Put it in a Worker that does
# the code→token exchange, and point the client at it:
# EMELI_TOKEN_PROXY_URL=https://<your-worker>/yahoo/token
